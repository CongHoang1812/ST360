<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Giai đoạn 2 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.rankingfilter.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_newFilter"
            app:destination="@id/newFilterFragment" />
        <action
            android:id="@+id/action_home_to_chooseFilter"
            app:destination="@id/chooseFilterFragment" />
        <action
            android:id="@+id/action_home_to_gallery"
            app:destination="@id/galleryFragment" />
        <action
            android:id="@+id/action_home_to_setting"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_home_to_preview"
            app:destination="@id/previewVideoFragment" />
    </fragment>

    <fragment
        android:id="@+id/previewVideoFragment"
        android:name="com.example.rankingfilter.ui.preview.PreviewVideoFragment"
        android:label="@string/home_trending_videos"
        tools:layout="@layout/fragment_preview_video">
        <argument
            android:name="thumb_url"
            app:argType="string" />
        <argument
            android:name="video_url"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_preview_to_chooseFilter"
            app:destination="@id/chooseFilterFragment" />
        <action
            android:id="@+id/action_preview_to_camera"
            app:destination="@id/cameraFragment" />
    </fragment>

    <!-- Giai đoạn 3: Choose a Filter (mode ALL) -->
    <fragment
        android:id="@+id/chooseFilterFragment"
        android:name="com.example.rankingfilter.ui.filter.ChooseFilterFragment"
        android:label="@string/title_choose_filter"
        tools:layout="@layout/fragment_choose_filter">
        <argument
            android:name="mode"
            android:defaultValue="ALL"
            app:argType="string" />
        <action
            android:id="@+id/action_chooseFilter_to_camera"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@+id/action_chooseFilter_to_makeFilter"
            app:destination="@id/makeFilterFragment" />
    </fragment>

    <!-- Giai đoạn 3: New filter (node 25:532), cùng Fragment với mode NEW_PACK.
         Dùng chung id action với chooseFilterFragment nên ChooseFilterFragment gọi được ở cả hai màn. -->
    <fragment
        android:id="@+id/newFilterFragment"
        android:name="com.example.rankingfilter.ui.filter.ChooseFilterFragment"
        android:label="@string/title_new_filter"
        tools:layout="@layout/fragment_choose_filter">
        <argument
            android:name="mode"
            android:defaultValue="NEW_PACK"
            app:argType="string" />
        <action
            android:id="@+id/action_chooseFilter_to_camera"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@+id/action_chooseFilter_to_makeFilter"
            app:destination="@id/makeFilterFragment" />
    </fragment>

    <!-- Giai đoạn 4: Make a Filter / Edit filter (filter_id khác null = sửa filter tự tạo) -->
    <fragment
        android:id="@+id/makeFilterFragment"
        android:name="com.example.rankingfilter.ui.makefilter.MakeFilterFragment"
        android:label="@string/title_make_filter"
        tools:layout="@layout/fragment_make_filter">
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Màn tạm, làm ở các giai đoạn sau -->

    <!-- Giai đoạn 5: Camera, nhận filter_id (+ is_user_filter cho filter tự tạo ở giai đoạn 4) -->
    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.rankingfilter.ui.camera.CameraFragment"
        android:label="@string/title_camera"
        tools:layout="@layout/fragment_camera">
        <argument
            android:name="filter_id"
            app:argType="string" />
        <argument
            android:name="is_user_filter"
            android:defaultValue="false"
            app:argType="boolean" />
        <!-- Xếp đủ 12 ô thì sang màn Preview (giai đoạn 6) -->
        <action
            android:id="@+id/action_camera_to_preview"
            app:destination="@id/resultPreviewFragment" />
    </fragment>

    <!-- Giai đoạn 6: Preview video vừa quay (Figma 8:334). Tạm là màn trống. -->
    <fragment
        android:id="@+id/resultPreviewFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_preview"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_preview"
            app:argType="reference" />
        <!-- content:// của video vừa quay (MediaStore, Movies/RankingFilter) -->
        <argument
            android:name="video_uri"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Giai đoạn 7: Gallery -->
    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_gallery"
            app:argType="reference" />
    </fragment>

    <!-- Giai đoạn 8: Setting -->
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_setting"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_setting"
            app:argType="reference" />
    </fragment>

</navigation>
