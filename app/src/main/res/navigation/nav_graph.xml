<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Giai đoạn 2 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.rankingfilter.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_newFilter"
            app:destination="@id/newFilterFragment" />
        <action
            android:id="@+id/action_home_to_chooseFilter"
            app:destination="@id/chooseFilterFragment" />
        <action
            android:id="@+id/action_home_to_gallery"
            app:destination="@id/galleryFragment" />
        <action
            android:id="@+id/action_home_to_setting"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_home_to_preview"
            app:destination="@id/previewVideoFragment" />
    </fragment>

    <fragment
        android:id="@+id/previewVideoFragment"
        android:name="com.example.rankingfilter.ui.preview.PreviewVideoFragment"
        android:label="@string/home_trending_videos"
        tools:layout="@layout/fragment_preview_video">
        <argument
            android:name="thumb_url"
            app:argType="string" />
        <argument
            android:name="video_url"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_preview_to_chooseFilter"
            app:destination="@id/chooseFilterFragment" />
    </fragment>

    <!-- Màn tạm, làm ở các giai đoạn sau -->
    <!-- Giai đoạn 3: New filter (node 25:532) -->
    <fragment
        android:id="@+id/newFilterFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_new_filter"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_new_filter"
            app:argType="reference" />
    </fragment>

    <!-- Giai đoạn 3: Choose a Filter. filter_id dùng ở giai đoạn 5 để mở thẳng Camera. -->
    <fragment
        android:id="@+id/chooseFilterFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_choose_filter"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_choose_filter"
            app:argType="reference" />
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Giai đoạn 7: Gallery -->
    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_gallery"
            app:argType="reference" />
    </fragment>

    <!-- Giai đoạn 8: Setting -->
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.example.rankingfilter.ui.common.ComingSoonFragment"
        android:label="@string/title_setting"
        tools:layout="@layout/fragment_coming_soon">
        <argument
            android:name="title"
            android:defaultValue="@string/title_setting"
            app:argType="reference" />
    </fragment>

</navigation>
