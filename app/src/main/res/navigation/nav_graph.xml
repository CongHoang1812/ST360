<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Giai đoạn 8: Splash → Language → Intro → Permission → Home -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.funny.rank.filters.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
        <action
            android:id="@+id/action_splash_to_intro"
            app:destination="@id/introFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
        <action
            android:id="@+id/action_splash_to_language"
            app:destination="@id/languageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.funny.rank.filters.ui.language.LanguageFragment"
        android:label="@string/language_title"
        tools:layout="@layout/fragment_language">
        <argument
            android:name="from_settings"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_language_to_intro"
            app:destination="@id/introFragment"
            app:popUpTo="@id/languageFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.funny.rank.filters.ui.intro.IntroFragment"
        tools:layout="@layout/fragment_intro">
        <action
            android:id="@+id/action_intro_to_permission"
            app:destination="@id/permissionFragment"
            app:popUpTo="@id/introFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
        <action
            android:id="@+id/action_intro_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/introFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
    </fragment>

    <fragment
        android:id="@+id/permissionFragment"
        android:name="com.funny.rank.filters.ui.permission.PermissionFragment"
        android:label="@string/title_permission"
        tools:layout="@layout/fragment_permission">
        <action
            android:id="@+id/action_permission_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/permissionFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
    </fragment>

    <!-- Giai đoạn 2 -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.funny.rank.filters.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_newFilter"
            app:destination="@id/newFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_home_to_chooseFilter"
            app:destination="@id/chooseFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_home_to_gallery"
            app:destination="@id/galleryFragment"
            app:enterAnim="@animator/nav_fade_in"
            app:exitAnim="@animator/nav_fade_out"
            app:popEnterAnim="@animator/nav_fade_in"
            app:popExitAnim="@animator/nav_fade_out" />
        <action
            android:id="@+id/action_home_to_setting"
            app:destination="@id/settingFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_home_to_preview"
            app:destination="@id/previewVideoFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter_solid"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/previewVideoFragment"
        android:name="com.funny.rank.filters.ui.preview.PreviewPagerFragment"
        android:label="@string/home_trending_videos"
        tools:layout="@layout/fragment_preview_pager">
        <argument
            android:name="thumb_url"
            app:argType="string" />
        <argument
            android:name="video_url"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_preview_to_chooseFilter"
            app:destination="@id/chooseFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_preview_to_camera"
            app:destination="@id/cameraFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 3: Choose a Filter (mode ALL) -->
    <fragment
        android:id="@+id/chooseFilterFragment"
        android:name="com.funny.rank.filters.ui.filter.ChooseFilterFragment"
        android:label="@string/title_choose_filter"
        tools:layout="@layout/fragment_choose_filter">
        <argument
            android:name="mode"
            android:defaultValue="ALL"
            app:argType="string" />
        <!-- true = mở từ nút chọn filter của Camera: chọn xong trả filter về Camera đó (không mở Camera mới) -->
        <argument
            android:name="pick_for_camera"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_chooseFilter_to_camera"
            app:destination="@id/cameraFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_chooseFilter_to_makeFilter"
            app:destination="@id/makeFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 3: New filter (node 25:532), cùng Fragment với mode NEW_PACK.
         Dùng chung id action với chooseFilterFragment nên ChooseFilterFragment gọi được ở cả hai màn. -->
    <fragment
        android:id="@+id/newFilterFragment"
        android:name="com.funny.rank.filters.ui.filter.ChooseFilterFragment"
        android:label="@string/title_new_filter"
        tools:layout="@layout/fragment_choose_filter">
        <argument
            android:name="mode"
            android:defaultValue="NEW_PACK"
            app:argType="string" />
        <argument
            android:name="pick_for_camera"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_chooseFilter_to_camera"
            app:destination="@id/cameraFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_chooseFilter_to_makeFilter"
            app:destination="@id/makeFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 4: Make a Filter / Edit filter (filter_id khác null = sửa filter tự tạo) -->
    <fragment
        android:id="@+id/makeFilterFragment"
        android:name="com.funny.rank.filters.ui.makefilter.MakeFilterFragment"
        android:label="@string/title_make_filter"
        tools:layout="@layout/fragment_make_filter">
        <argument
            android:name="filter_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- Tạo filter mới xong → Successful (57:137); gỡ Make a Filter khỏi back stack -->
        <action
            android:id="@+id/action_makeFilter_to_filterSuccess"
            app:destination="@id/filterSuccessFragment"
            app:popUpTo="@id/makeFilterFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Successful sau khi tạo filter (Figma 57:137) -->
    <fragment
        android:id="@+id/filterSuccessFragment"
        android:name="com.funny.rank.filters.ui.makefilter.FilterSuccessFragment"
        android:label="@string/title_success"
        tools:layout="@layout/fragment_filter_success">
        <argument
            android:name="filter_id"
            app:argType="string" />
        <!-- Try now: Back từ Camera về màn danh sách filter (bỏ Successful) -->
        <action
            android:id="@+id/action_filterSuccess_to_camera"
            app:destination="@id/cameraFragment"
            app:popUpTo="@id/filterSuccessFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Màn tạm, làm ở các giai đoạn sau -->

    <!-- Giai đoạn 5: Camera, nhận filter_id (+ is_user_filter cho filter tự tạo ở giai đoạn 4) -->
    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.funny.rank.filters.ui.camera.CameraFragment"
        android:label="@string/title_camera"
        tools:layout="@layout/fragment_camera">
        <argument
            android:name="filter_id"
            app:argType="string" />
        <argument
            android:name="is_user_filter"
            android:defaultValue="false"
            app:argType="boolean" />
        <!-- Quay xong thì sang màn Preview (giai đoạn 6) -->
        <action
            android:id="@+id/action_camera_to_preview"
            app:destination="@id/resultPreviewFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <!-- Nút chọn filter: mở màn chọn filter (pick_for_camera = true) chồng lên Camera. Back = về Camera giữ filter cũ;
             chọn filter = về lại chính Camera này và đổi filter (ChooseFilterFragment.RESULT_FILTER_ID). -->
        <action
            android:id="@+id/action_camera_to_chooseFilter"
            app:destination="@id/chooseFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_camera_to_newFilter"
            app:destination="@id/newFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_camera_to_addSound"
            app:destination="@id/addSoundFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 6: Preview video vừa quay (Figma 8:334) -->
    <fragment
        android:id="@+id/resultPreviewFragment"
        android:name="com.funny.rank.filters.ui.result.PreviewFragment"
        android:label="@string/title_preview"
        tools:layout="@layout/fragment_preview">
        <!-- Bản nháp trong filesDir/drafts -->
        <argument
            android:name="video_path"
            app:argType="string" />
        <!-- Nhạc đã chọn ở Add Sound, -1 = giữ tiếng gốc -->
        <argument
            android:name="music_id"
            android:defaultValue="-1"
            app:argType="integer" />
        <!-- Lưu xong: Back từ Successful về thẳng Home -->
        <action
            android:id="@+id/action_preview_to_success"
            app:destination="@id/successFragment"
            app:popUpTo="@id/homeFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 6: Successful (Figma 14:451) -->
    <fragment
        android:id="@+id/successFragment"
        android:name="com.funny.rank.filters.ui.result.SuccessFragment"
        android:label="@string/title_success"
        tools:layout="@layout/fragment_success">
        <argument
            android:name="video_path"
            app:argType="string" />
        <!-- Try More Filters: quay tiếp với filter khác; popUpTo Home gỡ Successful khỏi back stack
             nên Back từ Camera về Home (back stack: Home → Camera). -->
        <action
            android:id="@+id/action_success_to_camera"
            app:destination="@id/cameraFragment"
            app:popUpTo="@id/homeFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 6: Add Sound (Figma 14:620 / 22:738), mở từ pill trên Camera -->
    <fragment
        android:id="@+id/addSoundFragment"
        android:name="com.funny.rank.filters.ui.sound.AddSoundFragment"
        android:label="@string/camera_add_sound"
        tools:layout="@layout/fragment_add_sound">
        <argument
            android:name="selected_music_id"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <!-- Giai đoạn 7: Gallery (Figma 21:281): My Videos + My Filters -->
    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.funny.rank.filters.ui.gallery.GalleryFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment_gallery">
        <action
            android:id="@+id/action_gallery_to_viewer"
            app:destination="@id/videoViewerFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_gallery_to_chooseFilter"
            app:destination="@id/chooseFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_gallery_to_camera"
            app:destination="@id/cameraFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_gallery_to_makeFilter"
            app:destination="@id/makeFilterFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
        <action
            android:id="@+id/action_gallery_to_setting"
            app:destination="@id/settingFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

    <!-- Giai đoạn 7: xem một video đã lưu (Figma 8:278 / 21:368) -->
    <fragment
        android:id="@+id/videoViewerFragment"
        android:name="com.funny.rank.filters.ui.gallery.VideoViewerFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment_video_viewer">
        <argument
            android:name="video_path"
            app:argType="string" />
    </fragment>

    <!-- Giai đoạn 8: Setting -->
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.funny.rank.filters.ui.setting.SettingFragment"
        android:label="@string/title_setting"
        tools:layout="@layout/fragment_setting">
        <action
            android:id="@+id/action_setting_to_language"
            app:destination="@id/languageFragment"
            app:enterAnim="@animator/nav_enter"
            app:exitAnim="@animator/nav_exit"
            app:popEnterAnim="@animator/nav_pop_enter"
            app:popExitAnim="@animator/nav_pop_exit" />
    </fragment>

</navigation>
