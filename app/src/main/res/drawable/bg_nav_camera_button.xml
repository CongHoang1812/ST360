<?xml version="1.0" encoding="utf-8"?>
<!-- Nút camera giữa bottom nav: vòng trắng 68dp, viền xanh 4dp ở vòng 54dp, lõi trắng 48dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke
                android:width="4dp"
                android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
