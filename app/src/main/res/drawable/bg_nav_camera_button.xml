<?xml version="1.0" encoding="utf-8"?>
<!-- Nút camera giữa bottom nav: vòng trắng 68dp, viền xanh 4dp ở vòng 54dp, lõi trắng 48dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/nav_camera_button_item_bottom"
        android:left="@dimen/nav_camera_button_item_left"
        android:right="@dimen/nav_camera_button_item_right"
        android:top="@dimen/nav_camera_button_item_top">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke
                android:width="@dimen/nav_camera_button_stroke_width"
                android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
