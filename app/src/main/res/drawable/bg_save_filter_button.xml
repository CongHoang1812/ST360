<?xml version="1.0" encoding="utf-8"?>
<!-- Nút Save Filter: xám #CDCDCD khi chưa đủ điều kiện (Figma 57:326),
     gradient vàng như nút Create Filter khi bấm được (Figma 29:1871). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled" />
            <stroke android:width="1dp" android:color="@color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_create_filter_button" />
</selector>
