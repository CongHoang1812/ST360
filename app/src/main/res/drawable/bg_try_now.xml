<?xml version="1.0" encoding="utf-8"?>
<!-- Nút "Try now" (Figma 25:566): gradient #98DDFF → #009FEE, viền trắng 1dp, bo 12dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#009FEE"
        android:startColor="#98DDFF" />
    <stroke
        android:width="@dimen/try_now_stroke_width"
        android:color="@color/white" />
    <corners android:radius="@dimen/try_now_corners_radius" />
</shape>
