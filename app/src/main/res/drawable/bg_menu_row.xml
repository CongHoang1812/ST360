<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng menu: trắng, đang chọn = #B9E8FF (Figma 22:948 / 22:955), viền navy 1dp, bo 16dp -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/language_selected" />
            <stroke android:width="@dimen/menu_row_stroke_width" android:color="@color/navy" />
            <corners android:radius="@dimen/menu_row_corners_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="@dimen/menu_row_stroke2_width" android:color="@color/navy" />
            <corners android:radius="@dimen/menu_row_corners2_radius" />
        </shape>
    </item>
</selector>
