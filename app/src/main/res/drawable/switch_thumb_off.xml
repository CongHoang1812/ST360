<?xml version="1.0" encoding="utf-8"?>
<!-- Khung 28dp (= chiều cao ray) chứa núm tròn 20dp + bóng đổ 1dp xuống dưới.
     Kích thước dp cố định: tablet đã phóng cả công tắc bằng @dimen/switch_scale. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="28dp" android:height="28dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="21dp" android:height="21dp" android:gravity="center" android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/switch_thumb_off" />
            <stroke android:width="0.5dp" android:color="#0A000000" />
        </shape>
    </item>
</layer-list>
