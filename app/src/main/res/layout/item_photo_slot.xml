<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô trong lưới ảnh của Make a Filter: ảnh, ô "Add" hoặc ô trống có badge số.
     Ô vuông (design 100dp), bo 4dp, viền navy 1dp; ô đang chọn viền #00AAFF 4dp và nút xóa 28dp. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/cell"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_photo_cell_empty"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/Shape.Rounded4" />

        <!-- Ô "Add": dấu cộng 36dp + chữ Add 14sp, cách nhau 8dp -->
        <LinearLayout
            android:id="@+id/addContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/photo_slot_imageview1_width"
                android:layout_height="@dimen/photo_slot_imageview1_height"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add_photo_36" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:includeFontPadding="false"
                android:text="@string/make_filter_add"
                android:textColor="@color/navy"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Ô trống: badge số 28dp, đen 20% -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="@dimen/photo_slot_tv_badge_width"
            android:layout_height="@dimen/photo_slot_tv_badge_height"
            android:layout_gravity="center"
            android:background="@drawable/bg_photo_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            tools:text="2" />

        <!-- Nút xóa trên ô đang chọn: tại (60, 4) trong ô 100dp -->
        <ImageButton
            android:id="@+id/btnRemove"
            android:layout_width="@dimen/photo_slot_btn_remove_width"
            android:layout_height="@dimen/photo_slot_btn_remove_height"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/photo_slot_btn_remove_margin_top"
            android:layout_marginEnd="@dimen/photo_slot_btn_remove_margin_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_remove_photo"
            android:src="@drawable/ic_photo_delete" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
