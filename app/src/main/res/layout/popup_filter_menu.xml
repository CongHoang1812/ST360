<?xml version="1.0" encoding="utf-8"?>
<!-- Menu Edit / Delete khi bấm nút "…" trên ô filter tự tạo (Figma 22:557):
     nền đen 50%, viền trắng, bo 8dp, padding 20/12; mỗi dòng icon 24dp + chữ 16sp trắng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_menu"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/filter_menu_linearlayout1_padding_horizontal"
    android:paddingVertical="@dimen/filter_menu_linearlayout1_padding_vertical">

    <TextView
        android:id="@+id/menuEdit"
        style="@style/Text.FilterMenuItem"
        android:text="@string/filter_menu_edit"
        app:drawableStartCompat="@drawable/ic_edit_24" />

    <View
        android:layout_width="@dimen/filter_menu_view1_width"
        android:layout_height="@dimen/filter_menu_view1_height"
        android:layout_marginVertical="@dimen/space_s"
        android:background="@color/white" />

    <TextView
        android:id="@+id/menuDelete"
        style="@style/Text.FilterMenuItem"
        android:text="@string/filter_menu_delete"
        app:drawableStartCompat="@drawable/ic_delete_24" />
</LinearLayout>
