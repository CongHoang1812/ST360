<?xml version="1.0" encoding="utf-8"?>
<!-- Successful (Figma 14:451). Cuộn được vì màn thấp không đủ chỗ cho cả dải Try More Filters. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.result.SuccessFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/success_linearlayout1_padding_bottom">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/success_btn_home_margin_top"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_home"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_circle" />

            <!-- Ảnh thu nhỏ video 180 x 312 tại y=108, bo 8dp, viền trắng 2dp; bấm để mở video -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/success_materialcardview1_width"
                android:layout_height="@dimen/success_materialcardview1_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/success_materialcardview1_margin_top"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="@dimen/corner_8"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/success_materialcardview1_stroke_width">

                <ImageView
                    android:id="@+id/ivThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/cd_video_thumbnail"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/success_textview1_margin_top"
                android:gravity="center"
                android:text="@string/success_saved"
                android:textColor="@color/navy"
                android:textSize="@dimen/text_button" />

            <!-- Download: chép video ra thư viện ảnh của máy -->
            <FrameLayout
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/success_btn_download_margin_top"
                android:background="@drawable/bg_blue_gradient_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/space_s">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/success_imageview1_width"
                        android:layout_height="@dimen/success_imageview1_height"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_download_24" />

                    <TextView
                        android:id="@+id/tvDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/success_tv_download_margin_start"
                        android:text="@string/success_download"
                        android:textColor="@color/white"
                        android:textSize="@dimen/success_tv_download_text_size" />

                    <ProgressBar
                        android:id="@+id/downloadProgress"
                        android:layout_width="@dimen/success_download_progress_width"
                        android:layout_height="@dimen/success_download_progress_height"
                        android:layout_marginStart="@dimen/success_download_progress_margin_start"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                style="@style/Text.SuccessSection"
                android:text="@string/success_share_to" />

            <!-- 7 nút tròn 32dp trải đều hết chiều ngang (Figma 91:61) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/shareFacebook"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_facebook"
                    android:src="@drawable/ic_share_facebook" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareInstagram"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_instagram"
                    android:src="@drawable/ic_share_instagram" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareMessenger"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_messenger"
                    android:src="@drawable/ic_share_messenger" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareWhatsapp"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_whatsapp"
                    android:src="@drawable/ic_share_whatsapp" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareLine"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_line"
                    android:src="@drawable/ic_share_line" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareTiktok"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/share_tiktok"
                    android:src="@drawable/ic_share_tiktok" />

                <Space style="@style/Space.ShareGap" />

                <ImageView
                    android:id="@+id/shareMore"
                    style="@style/Image.ShareIcon"
                    android:contentDescription="@string/cd_share_more"
                    android:src="@drawable/ic_more_circle" />
            </LinearLayout>

            <TextView
                style="@style/Text.SuccessSection"
                android:text="@string/success_try_more" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:splitMotionEvents="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding"
                tools:itemCount="3"
                tools:listitem="@layout/item_filter" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
