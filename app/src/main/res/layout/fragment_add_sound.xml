<?xml version="1.0" encoding="utf-8"?>
<!-- Add Sound (Figma 14:620 / 22:738). Danh sách bắt đầu ở y=112 (dưới nút Back 24dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.sound.AddSoundFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/add_sound_header_padding_bottom">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Button.Back"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/add_sound_btn_back_margin_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/Text.ScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/add_sound_textview1_margin_horizontal"
                android:text="@string/camera_add_sound"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <ImageButton
                android:id="@+id/btnConfirm"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_confirm_music"
                android:enabled="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tick_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMusic"
            android:splitMotionEvents="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="8"
            tools:listitem="@layout/item_music" />
    </LinearLayout>

    <!-- Đang tải bài đã chọn về máy -->
    <FrameLayout
        android:id="@+id/busyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_20"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="@dimen/add_sound_progressbar1_width"
            android:layout_height="@dimen/add_sound_progressbar1_height"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />
    </FrameLayout>
</FrameLayout>
