<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery (Figma 21:281). Phần đầu giống Home; hai tab dạng thẻ; khung nội dung #EBF8FF; bottom nav (Gallery). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.gallery.GalleryFragment">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo + nút Setting, giống Home -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/logo"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_ranking_filter" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="10.84dp"
                android:layout_marginStart="9.45dp"
                android:layout_marginTop="2.1dp"
                android:importantForAccessibility="no"
                android:rotation="-20.34"
                android:scaleType="fitXY"
                android:src="@drawable/ic_crown_gold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hai tab 172 x 40 tại y=116: My Videos ở x=16, My Filters ở x=172 (chồng nhau 16dp).
         Tab không chọn thấp hơn 8dp và bị khung nội dung che phần đáy (đặt trong code). -->
    <TextView
        android:id="@+id/tabVideos"
        style="@style/Text.GalleryTab"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="24dp"
        android:text="@string/gallery_tab_videos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <TextView
        android:id="@+id/tabFilters"
        style="@style/Text.GalleryTab"
        android:layout_marginStart="156dp"
        android:text="@string/tab_my_filters"
        app:layout_constraintStart_toStartOf="@id/tabVideos"
        app:layout_constraintTop_toTopOf="@id/tabVideos" />

    <!-- Khung nội dung #EBF8FF, kéo xuống dưới bottom nav -->
    <View
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/card_blue"
        android:translationZ="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabVideos" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideos"
        style="@style/Recycler.GalleryGrid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/panel"
        tools:itemCount="4"
        tools:listitem="@layout/item_gallery_video" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilters"
        style="@style/Recycler.GalleryGrid"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/panel" />

    <!-- My Videos trống (Figma 21:423) -->
    <TextView
        android:id="@+id/emptyVideos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery_empty_videos"
        android:textColor="@color/navy"
        android:textSize="16sp"
        android:translationZ="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/panel" />

    <!-- My Filters trống (Figma 21:440) -->
    <LinearLayout
        android:id="@+id/emptyFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:translationZ="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_empty_filters_title"
            android:textColor="@color/navy"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFamily="@font/londrina_solid_light"
            android:text="@string/my_filters_empty_desc"
            android:textColor="@color/navy"
            android:textSize="16sp"
            app:fontFamily="@font/londrina_solid_light" />

        <FrameLayout
            android:id="@+id/btnCreateFilter"
            android:layout_width="210dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_create_filter_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="12dp"
                android:text="@string/create_filter"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:drawableStartCompat="@drawable/ic_add_circle_24" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/primary"
        android:translationZ="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/panel" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
