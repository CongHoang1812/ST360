<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom nav tự vẽ (Figma node 31:2385): cao 80dp, thanh trắng bo 2 góc trên 36dp bắt đầu ở y=24,
     nút camera 68dp ở giữa đè lên thanh. Logic ở ui/common/BottomNav.kt -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bottom_nav_nav_bar_margin_top"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="@dimen/bottom_nav_nav_bar_elevation"
        android:minHeight="@dimen/bottom_nav_nav_bar_min_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tâm tab Home ở x=96/360, tab Gallery ở x=264/360 -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="@dimen/bottom_nav_tab_home_width"
            android:layout_height="@dimen/bottom_nav_tab_home_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.2083"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="@dimen/bottom_nav_icon_home_width"
                android:layout_height="@dimen/bottom_nav_icon_home_height"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bottom_nav_label_home_height"
                android:gravity="center"
                android:text="@string/nav_home"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabGallery"
            android:layout_width="@dimen/bottom_nav_tab_gallery_width"
            android:layout_height="@dimen/bottom_nav_tab_gallery_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.7917"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iconGallery"
                android:layout_width="@dimen/bottom_nav_icon_gallery_width"
                android:layout_height="@dimen/bottom_nav_icon_gallery_height"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_gallery"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/labelGallery"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bottom_nav_label_gallery_height"
                android:gravity="center"
                android:text="@string/nav_gallery"
                android:textColor="@color/nav_inactive"
                android:textSize="@dimen/text_body"
                tools:ignore="TextContrastCheck" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/btnCamera"
        android:layout_width="@dimen/bottom_nav_camera"
        android:layout_height="@dimen/bottom_nav_camera"
        android:background="@drawable/bg_nav_camera_button"
        android:clickable="true"
        android:contentDescription="@string/cd_camera"
        android:elevation="@dimen/bottom_nav_btn_camera_elevation"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/bottom_nav_imageview1_width"
            android:layout_height="@dimen/bottom_nav_imageview1_height"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_camera" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
