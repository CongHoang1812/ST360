<?xml version="1.0" encoding="utf-8"?>
<!-- Màn tạm: dùng để nhìn thử font Londrina, nút Back, nút Primary, ô nhập Roboto, tab pill -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    tools:context=".ui.placeholder.PlaceholderFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginTop="@dimen/space_s">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Button.Back"
            android:layout_gravity="start|center_vertical" />

        <TextView
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/app_name" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        app:checkedButton="@id/tabA"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/tabA"
            style="@style/Tab.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <Button
            android:id="@+id/tabB"
            style="@style/Tab.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/app_name">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/placeholder_text" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:enabled="false"
        android:text="@string/placeholder_text" />

</LinearLayout>
