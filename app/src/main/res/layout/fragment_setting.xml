<?xml version="1.0" encoding="utf-8"?>
<!-- Setting (Figma 18:170): Back vàng, tiêu đề giữa, 4 hàng menu -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.setting.SettingFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Button.Back"
                android:layout_marginStart="@dimen/screen_padding" />

            <TextView
                style="@style/Text.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="60dp"
                android:gravity="center"
                android:text="@string/title_setting" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/rowLanguage"
            style="@style/Row.Menu">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_setting_language" />

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setting_language" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowRate"
            style="@style/Row.Menu">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_setting_rate" />

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setting_rate" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowShare"
            style="@style/Row.Menu">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_setting_share" />

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setting_share" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowPrivacy"
            style="@style/Row.Menu">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_setting_privacy" />

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/setting_privacy" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
