<?xml version="1.0" encoding="utf-8"?>
<!-- Ô video Trending: 156 x 240 trong design (tỉ lệ giữ nguyên khi co giãn), bo 8dp, viền trắng 1dp -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_trending_video"
        android:foreground="?attr/selectableItemBackground"
        android:padding="0.5dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_image_placeholder"
        app:layout_constraintDimensionRatio="156:240"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/Shape.Rounded8"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
