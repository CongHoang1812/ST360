<?xml version="1.0" encoding="utf-8"?>
<!-- Permission (Figma 3:7): ảnh 140dp, câu giải thích 16sp Light, 3 hàng công tắc, Continue -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.permission.PermissionFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/permission_textview1_height"
                android:layout_marginStart="@dimen/permission_textview1_margin_start"
                android:layout_marginTop="@dimen/permission_textview1_margin_top"
                android:text="@string/title_permission" />

            <ImageView
                android:layout_width="@dimen/permission_imageview1_width"
                android:layout_height="@dimen/permission_imageview1_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/permission_imageview1_margin_top"
                android:importantForAccessibility="no"
                android:src="@drawable/permission_girl" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:fontFamily="@font/londrina_solid_light"
                android:gravity="center"
                android:text="@string/permission_desc"
                android:textColor="@color/intro_text"
                android:textSize="@dimen/text_button"
                app:fontFamily="@font/londrina_solid_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/permission_linearlayout1_margin_top"
                android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowCamera"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/permission_row_camera_height"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/permission_row_camera_margin_top"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/permission_row_camera_padding_horizontal"
            android:paddingVertical="@dimen/permission_row_camera_padding_vertical">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_camera" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="@dimen/switch_scale"
                android:scaleY="@dimen/switch_scale"
                android:contentDescription="@string/permission_camera"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowStorage"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/permission_row_storage_height"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/permission_row_storage_margin_top"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/permission_row_storage_padding_horizontal"
            android:paddingVertical="@dimen/permission_row_storage_padding_vertical">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_storage" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="@dimen/switch_scale"
                android:scaleY="@dimen/switch_scale"
                android:contentDescription="@string/permission_storage"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowMicrophone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/permission_row_microphone_height"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/permission_row_microphone_margin_top"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/permission_row_microphone_padding_horizontal"
            android:paddingVertical="@dimen/permission_row_microphone_padding_vertical">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_microphone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMicrophone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="@dimen/switch_scale"
                android:scaleY="@dimen/switch_scale"
                android:contentDescription="@string/permission_microphone"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnContinue"
                style="@style/Text.IntroAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/permission_btn_continue_margin_top"
                android:text="@string/permission_continue" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
