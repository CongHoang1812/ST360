<?xml version="1.0" encoding="utf-8"?>
<!-- Permission (Figma 3:7): ảnh 140dp, câu giải thích 16sp Light, 3 hàng công tắc, Continue -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.permission.PermissionFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="12dp"
                android:text="@string/title_permission" />

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/permission_girl" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:fontFamily="@font/londrina_solid_light"
                android:gravity="center"
                android:text="@string/permission_desc"
                android:textColor="@color/intro_text"
                android:textSize="16sp"
                app:fontFamily="@font/londrina_solid_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowCamera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="4dp">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_camera" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/permission_camera"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowPhotos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="4dp">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_photos" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/permission_photos"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowMicrophone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_permission_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="4dp">

            <TextView
                style="@style/Text.MenuLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/permission_microphone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMicrophone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/permission_microphone"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnContinue"
                style="@style/Text.IntroAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:text="@string/permission_continue" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
