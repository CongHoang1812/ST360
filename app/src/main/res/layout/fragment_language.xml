<?xml version="1.0" encoding="utf-8"?>
<!-- Language (Figma 22:944; trong Setting 22:878 thêm nút Back) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ui.language.LanguageFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Button.Back"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/language_btn_back_margin_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/language_title_margin_start"
            android:text="@string/language_title"
            app:layout_constraintBottom_toBottomOf="@id/btnConfirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnConfirm" />

        <ImageButton
            android:id="@+id/btnConfirm"
            android:layout_width="@dimen/language_btn_confirm_width"
            android:layout_height="@dimen/language_btn_confirm_height"
            android:layout_marginTop="@dimen/language_btn_confirm_margin_top"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_confirm_language"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tick_on"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/language_list_margin_top"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnConfirm" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
