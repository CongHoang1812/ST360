<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Hình dạng bo góc ===== -->
    <style name="Shape.Rounded4" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_4</item>
    </style>
    <style name="Shape.Rounded8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_8</item>
    </style>
    <style name="Shape.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_12</item>
    </style>
    <style name="Shape.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Nút chính: nền #00AAFF, chữ trắng, bo 12dp, Londrina 16sp =====
         Khi setEnabled(false) nền tự chuyển sang #CDCDCD (Save Filter chưa đủ ảnh). -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.RankingFilter.LabelLarge</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/Shape.Rounded12</item>
    </style>

    <!-- ===== Card xanh nhạt: nền #EBF8FF, bo 12dp, đổ bóng nhẹ ===== -->
    <style name="Card.Blue" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_blue</item>
        <item name="cardElevation">2dp</item>
        <item name="shapeAppearance">@style/Shape.Rounded12</item>
        <item name="contentPadding">@dimen/space_m</item>
    </style>

    <!-- ===== Ô nhập: nền trắng, viền navy 1dp, bo 12dp, chữ Roboto ===== -->
    <style name="Input.Rounded" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/navy</item>
        <item name="boxStrokeWidth">@dimen/stroke_1</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_1</item>
        <item name="shapeAppearance">@style/Shape.Rounded12</item>
        <item name="hintTextColor">@color/navy</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.RankingFilter.Input</item>
    </style>
    <style name="ThemeOverlay.RankingFilter.Input" parent="">
        <item name="editTextStyle">@style/Widget.RankingFilter.EditText</item>
    </style>
    <style name="Widget.RankingFilter.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.RankingFilter.BodyLarge</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <!-- ===== Tab dạng pill (Discover / My Filters, Figma 25:178) =====
         Cao 37dp, chữ Londrina 18sp. Tab chọn: nền #00AAFF, chữ trắng, viền navy 1dp.
         Tab chưa chọn: nền trắng, chữ navy, không viền. Dùng với MaterialButton checkable. -->
    <style name="Tab.Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">@dimen/tab_pill_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/tab_pill_bg</item>
        <item name="android:textColor">@color/tab_pill_text</item>
        <item name="strokeColor">@color/tab_pill_stroke</item>
        <item name="strokeWidth">@dimen/stroke_1</item>
        <item name="shapeAppearance">@style/Shape.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.RankingFilter.LabelLarge</item>
        <item name="android:textSize">18sp</item>
        <item name="rippleColor">@color/overlay_20</item>
    </style>

    <!-- ===== Ô filter trong lưới (Figma "Frame filter"): viền navy 1dp, bo 4dp, không đổ bóng ===== -->
    <style name="Card.Filter" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/navy</item>
        <item name="strokeWidth">@dimen/stroke_1</item>
        <item name="shapeAppearance">@style/Shape.Rounded4</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- ===== Tiêu đề màn: Londrina 24sp, navy, giữa ===== -->
    <style name="Text.ScreenTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.RankingFilter.HeadlineSmall</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ===== Nút Back tròn vàng 36dp ===== -->
    <style name="Button.Back" parent="">
        <item name="android:layout_width">@dimen/back_button_size</item>
        <item name="android:layout_height">@dimen/back_button_size</item>
        <item name="android:src">@drawable/ic_back_circle</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">@string/cd_back</item>
    </style>

    <!-- ===== Nhãn card trong Make a Filter ("Filter Name", "Photos n/12", "Cover photo"): 16sp navy, cao 24dp ===== -->
    <style name="Text.CardLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ===== Nút trong popup xác nhận: chia đôi chiều ngang, padding 12dp, chữ 16sp ===== -->
    <style name="Text.DialogButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- ===== Lựa chọn trong popup Add Photo: khung viền #00AAFF bo 12dp, icon 22dp + chữ 18sp ở giữa ===== -->
    <style name="Frame.AddPhotoOption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_dialog_button_outline</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
    <style name="Text.AddPhotoOption" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- ===== Dòng trong menu Edit / Delete: icon 24dp + chữ 16sp trắng ===== -->
    <style name="Text.FilterMenuItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
