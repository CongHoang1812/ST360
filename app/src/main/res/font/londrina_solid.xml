<?xml version="1.0" encoding="utf-8"?>
<!-- Khai báo cả android: (API 26+) và app: (AppCompat cho API 24–25) -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/londrina_solid_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/londrina_solid_light"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/londrina_solid_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/londrina_solid_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
</font-family>
